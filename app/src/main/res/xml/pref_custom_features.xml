<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:key="category_custom_gestures"
        android:title="@string/category_custom_gestures_title">

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="cursor_key_swipe_move_enable_preference"
            android:summary="@string/cursor_key_swipe_move_summary"
            android:title="@string/cursor_key_swipe_move_title" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="delete_key_swipe_selection_enable_preference"
            android:summary="@string/delete_key_swipe_selection_summary"
            android:title="@string/delete_key_swipe_selection_title" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="category_multi_touch_gestures"
        android:title="@string/category_multi_touch_gestures_title">

        <ListPreference
            android:defaultValue="none"
            android:dialogTitle="@string/gesture_two_finger_swipe_left_title"
            android:entries="@array/multitouch_gesture_action_entries"
            android:entryValues="@array/multitouch_gesture_action_values"
            android:key="gesture_two_finger_swipe_left_preference"
            android:summary="%s"
            android:title="@string/gesture_two_finger_swipe_left_title" />

        <ListPreference
            android:defaultValue="none"
            android:dialogTitle="@string/gesture_two_finger_swipe_right_title"
            android:entries="@array/multitouch_gesture_action_entries"
            android:entryValues="@array/multitouch_gesture_action_values"
            android:key="gesture_two_finger_swipe_right_preference"
            android:summary="%s"
            android:title="@string/gesture_two_finger_swipe_right_title" />

        <ListPreference
            android:defaultValue="none"
            android:dialogTitle="@string/gesture_two_finger_swipe_up_title"
            android:entries="@array/multitouch_gesture_action_entries"
            android:entryValues="@array/multitouch_gesture_action_values"
            android:key="gesture_two_finger_swipe_up_preference"
            android:summary="%s"
            android:title="@string/gesture_two_finger_swipe_up_title" />

        <ListPreference
            android:defaultValue="none"
            android:dialogTitle="@string/gesture_two_finger_swipe_down_title"
            android:entries="@array/multitouch_gesture_action_entries"
            android:entryValues="@array/multitouch_gesture_action_values"
            android:key="gesture_two_finger_swipe_down_preference"
            android:summary="%s"
            android:title="@string/gesture_two_finger_swipe_down_title" />

        <ListPreference
            android:defaultValue="none"
            android:dialogTitle="@string/gesture_two_finger_pinch_in_title"
            android:entries="@array/multitouch_gesture_action_entries"
            android:entryValues="@array/multitouch_gesture_action_values"
            android:key="gesture_two_finger_pinch_in_preference"
            android:summary="%s"
            android:title="@string/gesture_two_finger_pinch_in_title" />

        <ListPreference
            android:defaultValue="none"
            android:dialogTitle="@string/gesture_two_finger_pinch_out_title"
            android:entries="@array/multitouch_gesture_action_entries"
            android:entryValues="@array/multitouch_gesture_action_values"
            android:key="gesture_two_finger_pinch_out_preference"
            android:summary="%s"
            android:title="@string/gesture_two_finger_pinch_out_title" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="category_custom_flick"
        android:title="@string/category_custom_flick_title">

        <ListPreference
            android:defaultValue="up_right"
            android:dialogTitle="@string/sumire_u_extension_mode_dialog_title"
            android:entries="@array/sumire_u_extension_mode_options"
            android:entryValues="@array/sumire_u_extension_mode_values"
            android:key="sumire_u_extension_mode_preference"
            android:summary="%s"
            android:title="@string/sumire_u_extension_mode_title" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="hierarchical_flick_transition_vibration_preference"
            android:summary="@string/hierarchical_flick_transition_vibration_summary"
            android:title="@string/hierarchical_flick_transition_vibration_title" />

        <Preference
            android:key="hierarchical_flick_angle_margin_preference"
            android:title="@string/hierarchical_flick_angle_margin_preference_title"
            app:summary="@string/hierarchical_flick_angle_margin_preference_summary" />

        <Preference
            android:key="circular_slot_action_setting_preference"
            android:title="Circular Flick SLOT4〜6 設定"
            app:summary="日本語・英語・数字モードの通常キーに、追加フリックアクションを設定します" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="category_custom_special_keys"
        android:title="@string/category_custom_special_keys_title">

        <Preference
            android:key="sumire_special_key_editor_preference"
            android:title="@string/sumire_special_key_editor_preference_title"
            app:summary="@string/sumire_special_key_editor_preference_summary" />

    </PreferenceCategory>

</PreferenceScreen>
